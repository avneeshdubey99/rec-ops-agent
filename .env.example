# LLM provider: anthropic (default) or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
# claude-sonnet-5 (default, good balance) | claude-haiku-4-5-20251001 (cheapest) | claude-opus-5 (strongest)
LLM_MODEL=claude-sonnet-5

# Only needed if LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# Randomly fail this fraction of database calls to watch recovery (0 = off)
CHAOS_FAILURE_RATE=0
